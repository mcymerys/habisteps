---
import { z } from "zod";
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getGoal } from "@/lib/services/goals";
import {
  categoryLabel,
  endConditionSummary,
  priorityLabel,
  scheduleSummary,
  weeklyProgressText,
} from "@/lib/goal-format";

// A non-UUID would make Postgres raise an error (-> 500), so reject it before querying.
const idResult = z.uuid().safeParse(Astro.params.id);

let goal = null;
if (idResult.success) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) throw new Error("Supabase is not configured");
  goal = await getGoal(supabase, idResult.data);
}

// "Not found" and "belongs to someone else" (hidden by RLS) must look identical.
if (!goal) Astro.response.status = 404;
---

<Layout title={goal ? goal.name : "Goal not found"}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <a href="/dashboard" class="text-sm text-purple-300 hover:underline">
        &larr; Back to dashboard
      </a>
      {goal ? (
        <>
          <h1 class="mt-3 mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            {goal.name}
          </h1>
          <dl class="space-y-2 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-blue-100/60">Category</dt>
              <dd>{categoryLabel(goal.category)}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-blue-100/60">Priority</dt>
              <dd>{priorityLabel(goal.priority)}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-blue-100/60">Type</dt>
              <dd>{goal.timing.kind === "one_off" ? "One-off" : "Recurring"}</dd>
            </div>
            {goal.timing.kind === "one_off" && (
              <div class="flex justify-between gap-4">
                <dt class="text-blue-100/60">Deadline</dt>
                <dd>{goal.timing.deadline}</dd>
              </div>
            )}
            {endConditionSummary(goal) && (
              <div class="flex justify-between gap-4">
                <dt class="text-blue-100/60">Each time</dt>
                <dd>{endConditionSummary(goal)}</dd>
              </div>
            )}
            <div class="flex justify-between gap-4">
              <dt class="text-blue-100/60">Schedule</dt>
              <dd>{scheduleSummary(goal)}</dd>
            </div>
          </dl>
          <div class="mt-6 rounded-lg border border-white/10 bg-white/5 p-4">
            <p class="text-lg font-semibold">Streak: 0 days</p>
            <p class="mt-1 text-sm text-blue-100/70">{weeklyProgressText(goal)}</p>
          </div>
        </>
      ) : (
        <>
          <h1 class="mt-3 mb-2 text-2xl font-bold">Goal not found</h1>
          <p class="text-blue-100/70">
            This goal doesn't exist or you don't have access to it.{" "}
            <a href="/dashboard" class="text-purple-300 hover:underline">
              Back to your goals
            </a>
          </p>
        </>
      )}
    </div>
  </div>
</Layout>
